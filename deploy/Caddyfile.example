{$MEERKAT_DOMAIN} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy https://outlet:8443 {
		transport http {
			tls_trust_pool file /etc/caddy/root-ca.pem
			tls_server_name outlet
		}
	}
}

# Add one site block for each registered public route, for example:
app.{$MEERKAT_DOMAIN} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy http://outlet:24000
}
