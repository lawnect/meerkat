{
	metrics {
		per_host
	}
	on_demand_tls {
		ask http://outlet:8080/.well-known/meerkat/cert-ask
	}
}

:9090 {
	metrics /metrics
}

http:// {
	redir https://{host}{uri} permanent
}

https:// {
	tls {
		on_demand
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy http://outlet:8080
}
