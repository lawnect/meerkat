 	}
 }
+
+// Meerkat regression: TLS authenticates the hostname, never the Host port.
+// No metric family may allocate a distinct series for its arbitrary suffix.
+func TestMetricsHostPorts(t *testing.T) {
+	ctx, cancel := caddy.NewContext(caddy.Context{Context: context.Background()})
+	defer cancel()
+	metrics := &Metrics{
+		PerHost:        true,
+		hasHTTPSServer: true,
+		httpMetrics:    &httpMetrics{},
+		allowedHosts:   make(map[string]struct{}),
+	}
+	handler := newMetricsInstrumentedRoute(ctx, "test", HandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		_, err := w.Write([]byte("hello"))
+		return err
+	}), metrics)
+	hosts := []string{"app.example.com", "app.example.com:443", "APP.EXAMPLE.COM:0443", "app.example.com:port-a", "app.example.com:port-b", "app.example.com:"}
+	for _, host := range hosts {
+		r := httptest.NewRequest("POST", "https://app.example.com/", strings.NewReader("body"))
+		r.Host = host
+		if err := handler.ServeHTTP(httptest.NewRecorder(), r); err != nil {
+			t.Fatal(err)
+		}
+	}
+	families, err := ctx.GetMetricsRegistry().Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, family := range families {
+		if !strings.HasPrefix(family.GetName(), "caddy_http_") {
+			continue
+		}
+		for _, metric := range family.Metric {
+			for _, label := range metric.Label {
+				if label.GetName() == "host" && label.GetValue() != "app.example.com" {
+					t.Fatalf("%s allocated unnormalized host %q", family.GetName(), label.GetValue())
+				}
+			}
+		}
+	}
+	if got := testutil.ToFloat64(metrics.httpMetrics.requestCount); got != float64(len(hosts)) {
+		t.Fatalf("requests = %v, want %d", got, len(hosts))
+	}
+	if got := testutil.CollectAndCount(metrics.httpMetrics.responseSize); got != 1 {
+		t.Fatalf("response size series = %d, want 1", got)
+	}
+}
