{
  "openapi": "3.0.3",
  "info": {
    "title": "Meerkat vertical slice API",
    "version": "0.1.0",
    "description": "Connector registration, multi-service configuration, heartbeat and administrator status API. Legacy single-service fields remain for compatibility with existing connectors."
  },
  "servers": [
    {
      "url": "https://localhost:18443",
      "description": "Local Compose PoC; trust its generated development certificate"
    }
  ],
  "security": [
    {
      "connectorCredential": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "Outlet API readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acknowledgment"
                }
              }
            }
          }
        }
      }
    },
    "/connector/v1/enrollment": {
      "post": {
        "operationId": "enrollConnector",
        "summary": "Consume a short-lived one-time registration token",
        "security": [
          {
            "enrollmentToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered; save the returned credential before starting the tunnel",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/InvalidMediaType"
          },
          "503": {
            "$ref": "#/components/responses/PersistenceFailure"
          }
        }
      }
    },
    "/connector/v1/config": {
      "get": {
        "operationId": "connectorConfiguration",
        "summary": "Return only the caller's permitted service",
        "responses": {
          "200": {
            "description": "Private configuration; never log this payload",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Configuration"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/connector/v1/heartbeat": {
      "post": {
        "operationId": "connectorHeartbeat",
        "summary": "Report process state and local health; Outlet probes the HTTP tunnel separately",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acknowledgment"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/InvalidMediaType"
          },
          "503": {
            "$ref": "#/components/responses/PersistenceFailure"
          }
        }
      }
    },
    "/api/v1/connectors": {
      "get": {
        "operationId": "listConnectors",
        "summary": "Inspect separate control, process, health and tunnel states",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status without secret configurations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "connectors"
                  ],
                  "properties": {
                    "connectors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ConnectorStatus"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getOutletUsage",
        "summary": "Outlet-wide request usage grouped into hour, day, month or year buckets",
        "description": "Sums the Outlet-wide hourly totals, which are kept for 10 years, into calendar buckets of the requested time zone. Buckets cover [from, to) and are aligned to the unit in tz; a from that is not on a boundary is aligned down. Every bucket in the range is returned, with zeros when nothing was recorded. Hour buckets are one elapsed hour long, and day, month and year buckets follow the calendar, so a daylight-saving day can be 23 or 25 hours.",
        "security": [{ "adminToken": [] }],
        "parameters": [
          { "name": "unit", "in": "query", "required": true, "schema": { "type": "string", "enum": ["hour", "day", "month", "year"] } },
          { "name": "from", "in": "query", "required": true, "description": "Inclusive start, RFC 3339", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "required": true, "description": "Exclusive end, RFC 3339; must be after from", "schema": { "type": "string", "format": "date-time" } },
          { "name": "tz", "in": "query", "required": false, "description": "IANA time zone used to align buckets", "schema": { "type": "string", "default": "UTC", "example": "Asia/Seoul" } }
        ],
        "responses": {
          "200": {
            "description": "One entry per bucket of requests, estimated incoming bytes, response body bytes, and HTTP 5xx responses",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["unit", "buckets", "connectors"],
              "properties": {
                "unit": { "type": "string", "enum": ["hour", "day", "month", "year"] },
                "updated_at": { "type": "string", "format": "date-time", "description": "Last collection time; omitted before the first collection" },
                "buckets": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["start", "requests", "request_bytes", "response_bytes", "error_responses", "rate_limited"], "properties": {
                  "start": { "type": "string", "format": "date-time", "description": "Bucket start in the requested time zone", "example": "2026-10-01T00:00:00+09:00" },
                  "requests": { "type": "integer", "format": "int64" },
                  "request_bytes": { "type": "integer", "format": "int64" },
                  "response_bytes": { "type": "integer", "format": "int64" },
                  "error_responses": { "type": "integer", "format": "int64" },
                  "rate_limited": { "type": "integer", "format": "int64", "description": "Requests the Outlet rejected with 429" }
                } } },
                "connectors": { "type": "array", "description": "Totals per tunnel over the whole range, busiest first; tunnels without requests are left out. Built from per-route hours, which are kept for 30 days.", "items": { "type": "object", "required": ["connector_id", "name", "requests", "request_bytes", "response_bytes", "error_responses"], "properties": {
                  "connector_id": { "type": "string" },
                  "name": { "type": "string" },
                  "requests": { "type": "integer", "format": "int64" },
                  "request_bytes": { "type": "integer", "format": "int64" },
                  "response_bytes": { "type": "integer", "format": "int64" },
                  "error_responses": { "type": "integer", "format": "int64" }
                } } }
              }
            } } }
          },
          "400": {
            "description": "invalid_usage_range: unknown unit or time zone, unparsable or non-increasing from and to, or more than 1000 buckets",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/PersistenceFailure" }
        }
      }
    },
    "/api/v1/connectors/{id}/usage": {
      "get": {
        "operationId": "getConnectorUsage",
        "summary": "Recent hourly HTTP usage for a tunnel and its services",
        "security": [{ "adminToken": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Label" } }],
        "responses": {
          "200": {
            "description": "Last 24 UTC hourly buckets of requests, estimated incoming bytes, response body bytes, and HTTP 5xx responses",
            "content": { "application/json": { "schema": {
              "type": "object",
              "required": ["period_hours", "hours", "services"],
              "properties": {
                "period_hours": { "type": "integer", "example": 24 },
                "updated_at": { "type": "string", "format": "date-time" },
                "hours": { "type": "array", "items": { "type": "object", "properties": {
                  "hour": { "type": "string", "format": "date-time" },
                  "requests": { "type": "integer", "format": "int64" },
                  "request_bytes": { "type": "integer", "format": "int64" },
                  "response_bytes": { "type": "integer", "format": "int64" },
                  "error_responses": { "type": "integer", "format": "int64" }
                } } },
                "services": { "type": "array", "items": { "type": "object", "properties": {
                  "service_id": { "type": "string" },
                  "name": { "type": "string" },
                  "requests": { "type": "integer", "format": "int64" },
                  "request_bytes": { "type": "integer", "format": "int64" },
                  "response_bytes": { "type": "integer", "format": "int64" },
                  "error_responses": { "type": "integer", "format": "int64" }
                } } }
              }
            } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/PersistenceFailure" }
        }
      }
    },
    "/api/v1/connectors/{id}/enrollment-tokens": {
      "post": {
        "operationId": "issueEnrollmentToken",
        "summary": "Issue or rotate a reusable tunnel run token",
        "description": "The token remains valid until rotated or the connector is deleted. Active identities return 409 unless reset=true; resetting rotates service tokens and disconnects the old tunnel.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Label"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Reusable run secret; returned only when issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "token"
                  ],
                  "properties": {
                    "token": {
                      "$ref": "#/components/schemas/Secret"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/PersistenceFailure"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "enrollmentToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Single-use token, default lifetime 10 minutes"
      },
      "connectorCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-connector API credential, default lifetime 30 days"
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bootstrap administrator API token; no login UI in this slice"
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid, unknown, missing or oversized fields",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, expired, consumed or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Token belongs to another connector or service",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Active identity, revision mismatch or out-of-order heartbeat",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Connector not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InvalidMediaType": {
        "description": "Content-Type must be application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PersistenceFailure": {
        "description": "State could not be durably saved",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Label": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,62}$"
      },
      "Secret": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{32,128}$",
        "description": "Secret token: never log; returned only on explicitly authorized secret-bearing endpoints"
      },
      "PublicKey": {
        "type": "string",
        "format": "byte",
        "description": "Base64 encoding of exactly 32 bytes"
      },
      "Target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "port"
        ],
        "properties": {
          "host": {
            "type": "string",
            "description": "Explicit single-label Compose service name or loopback IP; checked against a local Connector target when one is configured"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "Tunnel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "remote_address",
          "server_public_key",
          "service_name",
          "service_token"
        ],
        "properties": {
          "remote_address": {
            "type": "string",
            "description": "rathole server host:port"
          },
          "server_public_key": {
            "$ref": "#/components/schemas/PublicKey"
          },
          "service_name": {
            "$ref": "#/components/schemas/Label"
          },
          "service_token": {
            "$ref": "#/components/schemas/Secret"
          }
        }
      },
      "Configuration": {
        "type": "object",
        "description": "The services array contains all services for a tunnel. An absent or empty array means the connector is enrolled and waiting. Legacy service_id, target, and tunnel fields are retained for older persisted configurations.",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "revision",
          "service_id",
          "target",
          "tunnel"
        ],
        "properties": {
          "connector_id": {
            "$ref": "#/components/schemas/Label"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "service_id": {
            "anyOf": [{"$ref": "#/components/schemas/Label"}, {"const": ""}]
          },
          "target": {
            "anyOf": [{"$ref": "#/components/schemas/Target"}, {"$ref": "#/components/schemas/PendingTarget"}]
          },
          "tunnel": {
            "anyOf": [{"$ref": "#/components/schemas/Tunnel"}, {"$ref": "#/components/schemas/PendingTunnel"}]
          },
          "services": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ServiceConfiguration"}
          }
        }
      },
      "ServiceConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id", "target", "tunnel"],
        "properties": {
          "service_id": {"$ref": "#/components/schemas/Label"},
          "target": {"$ref": "#/components/schemas/Target"},
          "tunnel": {"$ref": "#/components/schemas/Tunnel"}
        }
      },
      "PendingTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port"],
        "properties": {"host": {"const": ""}, "port": {"const": 0}}
      },
      "PendingTunnel": {
        "type": "object",
        "additionalProperties": false,
        "required": ["remote_address", "server_public_key", "service_name", "service_token"],
        "properties": {
          "remote_address": {"const": ""},
          "server_public_key": {"const": ""},
          "service_name": {"const": ""},
          "service_token": {"const": ""}
        }
      },
      "EnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector_name",
          "connector_version",
          "public_key"
        ],
        "properties": {
          "connector_name": {
            "$ref": "#/components/schemas/Label"
          },
          "connector_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "public_key": {
            "$ref": "#/components/schemas/PublicKey"
          }
        }
      },
      "EnrollmentResponse": {
        "type": "object",
        "description": "An enrolled Connector receives its complete services array; an absent or empty array means no service has been added yet.",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "revision",
          "service_id",
          "target",
          "tunnel",
          "credential"
        ],
        "properties": {
          "connector_id": {
            "$ref": "#/components/schemas/Label"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "service_id": {
            "anyOf": [{"$ref": "#/components/schemas/Label"}, {"const": ""}]
          },
          "target": {
            "anyOf": [{"$ref": "#/components/schemas/Target"}, {"$ref": "#/components/schemas/PendingTarget"}]
          },
          "tunnel": {
            "anyOf": [{"$ref": "#/components/schemas/Tunnel"}, {"$ref": "#/components/schemas/PendingTunnel"}]
          },
          "services": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/ServiceConfiguration"}
          },
          "credential": {
            "$ref": "#/components/schemas/Secret"
          },
          "credential_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Only present for legacy expiring credentials; reusable run tokens have no expiry."
          }
        }
      },
      "Heartbeat": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "service_id",
          "revision",
          "connector_version",
          "process_state",
          "process_restarts",
          "service_health",
          "observed_at"
        ],
        "properties": {
          "connector_id": {
            "$ref": "#/components/schemas/Label"
          },
          "service_id": {
            "anyOf": [{"$ref": "#/components/schemas/Label"}, {"const": ""}]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "connector_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "process_state": {
            "type": "string",
            "enum": [
              "not_started",
              "starting",
              "running",
              "restarting",
              "stopped",
              "failed"
            ]
          },
          "process_restarts": {
            "type": "integer",
            "minimum": 0
          },
          "service_health": {
            "type": "string",
            "enum": [
              "unknown",
              "healthy",
              "unhealthy"
            ]
          },
          "service_healths": {
            "type": "object",
            "additionalProperties": {"type": "string", "enum": ["unknown", "healthy", "unhealthy"]}
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConnectorStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "service_id",
          "status",
          "tunnel_status",
          "last_seen",
          "heartbeat"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Label"
          },
          "name": {
            "$ref": "#/components/schemas/Label"
          },
          "service_id": {
            "$ref": "#/components/schemas/Label"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "connected",
              "stale",
              "disconnected"
            ]
          },
          "tunnel_status": {
            "type": "string",
            "enum": [
              "unknown",
              "connected",
              "disconnected"
            ]
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          },
          "heartbeat": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Heartbeat"
              }
            ],
            "nullable": true
          },
          "credential_expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Acknowledgment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "accepted"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
